+    def _request_actor_ref(self, request: "web.Request") -> str:
+        """local (jarvis): the X-Jarvis-Actor-Ref to bind for this request, or ""."""
+        raw = request.headers.get("X-Jarvis-Actor-Ref", "").strip()
+        if not raw:
+            return ""
+        why = ""
+        if not _ACTOR_REF_RE.match(raw):
+            why = "not an app actor reference"
+        elif request.remote not in ("127.0.0.1", "::1"):
+            why = "not a loopback caller"
+        elif not self._expected_api_key() or self._check_auth(request) is not None:
+            why = "request not authenticated with API_SERVER_KEY"
+        if why:
+            logger.warning("X-Jarvis-Actor-Ref ignored: %s", why)
+            return ""
+        return raw
