#!/bin/bash
# Jarvis for Mac, as downloaded: an installer. macOS checks Full Disk Access
# against the signed program that is running, and a bash script that hands
# off to osascript is never "Jarvis" to it. So this builds the real app here:
# osacompile turns Resources/helper.js into an applet, it is signed for this
# Mac, and it replaces any older Jarvis in Applications. That applet is what
# you open and what the background sync runs, so the Jarvis switch in Full
# Disk Access is the one that counts.
set -u
SRC="$(cd "$(dirname "$0")/../.." && pwd -P)"
RES="$SRC/Contents/Resources"
ID=com.jarvis.messages
AGENT="$HOME/Library/LaunchAgents/$ID.plist"
LOG="$HOME/Library/Logs/Jarvis-install.log"
mkdir -p "$HOME/Library/Logs"
exec >>"$LOG" 2>&1
echo "== $(date) install from $SRC"

fail() {
  echo "FAILED: $1"
  /usr/bin/osascript -e 'on run argv' -e 'display dialog (item 1 of argv) buttons {"OK"} default button "OK" with title "Jarvis" with icon stop' -e 'end run' \
    "Jarvis couldn't finish setting up: $1"$'\n\n'"Details are in ~/Library/Logs/Jarvis-install.log." >/dev/null 2>&1
  exit 1
}

DEST=/Applications
[ -w "$DEST" ] || { DEST="$HOME/Applications"; mkdir -p "$DEST"; }

# Every build is signed anew, and Full Disk Access belongs to one signature:
# rebuilding the same app would switch access off. Opening the download again
# with nothing new just opens the installed Jarvis.
STAMP="$HOME/Library/Application Support/Jarvis/installed.sha256"
WANT="$(cat "$RES/helper.js" "$RES/server.txt" | /usr/bin/shasum -a 256 | cut -d' ' -f1)"
for D in /Applications "$HOME/Applications"; do
  if [ -x "$D/Jarvis.app/Contents/MacOS/applet" ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$WANT $D" ]; then
    echo "already installed at $D/Jarvis.app; opening it, not rebuilding"
    exec /usr/bin/open "$D/Jarvis.app"
  fi
done

BUILD="$(mktemp -d "${TMPDIR:-/tmp}/jarvis-build.XXXXXX")" || fail "no scratch folder"
APP="$BUILD/Jarvis.app"

/usr/bin/osacompile -l JavaScript -o "$APP" "$RES/helper.js" || fail "osacompile could not build the app"
cp "$RES/server.txt" "$APP/Contents/Resources/server.txt" || fail "no server address in the download"
PL="$APP/Contents/Info.plist"
/usr/bin/plutil -replace CFBundleIdentifier -string "$ID" "$PL" &&
  /usr/bin/plutil -replace CFBundleName -string Jarvis "$PL" &&
  /usr/bin/plutil -replace CFBundleDisplayName -string Jarvis "$PL" &&
  /usr/bin/plutil -replace LSUIElement -bool true "$PL" || fail "could not name the app"
/usr/bin/codesign --force --deep --sign - --identifier "$ID" "$APP" || fail "could not sign the app"
/usr/bin/codesign --verify --deep "$APP" || fail "the signed app did not verify"

# Stop whatever older Jarvis is running or scheduled before replacing it.
/bin/launchctl bootout "gui/$(id -u)" "$AGENT" 2>/dev/null
/usr/bin/pkill -f "Jarvis.app/Contents/Resources/helper.js" 2>/dev/null
/usr/bin/pkill -f "$DEST/Jarvis.app/Contents/MacOS/applet" 2>/dev/null
# An older Jarvis left a Full Disk Access entry that no longer matches what
# is signed; it can show as switched on and still not work. Clear it so the
# new Jarvis is added fresh. Older macOS may refuse; that only means the
# person removes it with the minus button, which the app tells them.
if /usr/bin/tccutil reset SystemPolicyAllFiles "$ID"; then echo "cleared the old Full Disk Access entry"
else echo "WARNING: tccutil could not clear the old Full Disk Access entry"; fi

rm -rf "$DEST/Jarvis.app.new"
/usr/bin/ditto "$APP" "$DEST/Jarvis.app.new" || fail "could not copy Jarvis to $DEST"
rm -rf "$DEST/Jarvis.app" && mv "$DEST/Jarvis.app.new" "$DEST/Jarvis.app" || fail "could not put Jarvis in $DEST"
/usr/bin/xattr -dr com.apple.quarantine "$DEST/Jarvis.app" 2>/dev/null
rm -rf "$BUILD"
mkdir -p "$(dirname "$STAMP")" && echo "$WANT $DEST" > "$STAMP" || echo "WARNING: could not record the install; opening the download again will rebuild"
echo "installed $DEST/Jarvis.app"
exec /usr/bin/open "$DEST/Jarvis.app"
