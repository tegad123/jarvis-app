# Connects the browser to public addresses on ports 80, 443 and 8443 and
# nothing else, and logs every connection. The code refuses private, loopback
# and link-local addresses itself; IPAddressDeny refuses them again in the
# kernel, so a bug in one is caught by the other. 127.0.0.53 is the local DNS
# resolver, the one private address it needs.
[Unit]
Description={{DISPLAY_NAME}} — web browser egress
Requires={{SLUG}}-egress.socket
After={{SLUG}}-egress.socket

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 -I {{BROWSER_CODE}}/browser_egress.py
Restart=on-failure
RestartSec=5
IPAddressDeny=localhost link-local multicast 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 172.16.0.0/12 192.0.0.0/24 192.168.0.0/16 198.18.0.0/15 240.0.0.0/4 fc00::/7 fec0::/10
IPAddressAllow=127.0.0.53/32
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
InaccessiblePaths=-/etc/jarvis -/opt/{{SLUG}} -/usr/local/lib/hermes-agent -/var/lib/postgresql
MemoryMax=128M
TasksMax=64
