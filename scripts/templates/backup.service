[Unit]
Description={{DISPLAY_NAME}} — WAL-inclusive state backup
After={{SLUG}}-app.service

[Service]
Type=oneshot
WorkingDirectory=/root/jarvis-app
ExecStart={{VENV_PYTHON}} /root/jarvis-app/scripts/backup_tenant.py --slug {{SLUG}} --dest {{BACKUP_ROOT}} --keep-daily {{BACKUP_KEEP}}
Environment=PYTHONUNBUFFERED=1
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
