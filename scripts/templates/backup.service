[Unit]
Description={{DISPLAY_NAME}} — WAL-inclusive state backup
After={{SLUG}}-app.service

[Service]
Type=oneshot
WorkingDirectory={{JARVIS_APP}}
ExecStart={{VENV_PYTHON}} {{JARVIS_APP}}/scripts/backup_tenant.py --slug {{SLUG}} --dest {{BACKUP_ROOT}} --keep-daily {{BACKUP_KEEP}}
Environment=PYTHONUNBUFFERED=1
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
