# One Chromium per person, started on demand through the socket. It has no
# network of its own (PrivateNetwork): every page it loads goes through the
# egress proxy, which reaches public addresses only. Chromium's own sandbox
# needs user namespaces, which this kernel restricts, so it runs with
# --no-sandbox; the boundary is this unit: its own user, no network, no view
# of the tenant's files or secrets.
[Unit]
Description={{DISPLAY_NAME}} — web browser
Requires={{SLUG}}-browser.socket {{SLUG}}-egress.socket
After={{SLUG}}-browser.socket {{SLUG}}-egress.socket

[Service]
Type=simple
User={{WEB_USER}}
Group={{WEB_USER}}
ExecStart=/usr/bin/python3 -I {{BROWSER_CODE}}/browser_worker.py
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=jarvis-browser/{{SLUG}}
StateDirectoryMode=0700
Environment=HOME=/var/lib/jarvis-browser/{{SLUG}}
Environment=JARVIS_BROWSER_PROFILE=/var/lib/jarvis-browser/{{SLUG}}/people
Environment=JARVIS_BROWSER_BIN={{BROWSER_BIN}}
Environment=JARVIS_EGRESS_SOCKET=/run/jarvis-egress/{{SLUG}}.sock
Environment=JARVIS_BROWSER_MAX_OPEN={{BROWSER_MAX_OPEN}}
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
InaccessiblePaths=-/etc/jarvis -/opt/{{SLUG}} -/usr/local/lib/hermes-agent -/var/lib/postgresql
MemoryMax={{BROWSER_MEMORY_MAX}}
TasksMax=512
CPUQuota=150%
