# The browser's only way out. Only the browser's user can reach it.
[Unit]
Description={{DISPLAY_NAME}} — web browser egress (socket)

[Socket]
ListenStream=/run/jarvis-egress/{{SLUG}}.sock
SocketUser={{WEB_USER}}
SocketGroup={{WEB_USER}}
SocketMode=0600
DirectoryMode=0755

[Install]
WantedBy=sockets.target
